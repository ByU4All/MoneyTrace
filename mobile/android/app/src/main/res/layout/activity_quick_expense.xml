<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Quick Expense"
        android:textColor="@color/widget_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Amount -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Amount (₹)"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/edit_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background"
        android:hint="0.00"
        android:inputType="numberDecimal"
        android:layout_marginBottom="12dp"
        android:textColor="@color/widget_text_primary"
        android:textColorHint="@color/widget_text_secondary"
        android:textSize="16sp" />

    <!-- Category -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Category"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <AutoCompleteTextView
        android:id="@+id/edit_category"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background"
        android:completionThreshold="1"
        android:hint="Type or pick category"
        android:layout_marginBottom="12dp"
        android:textColor="@color/widget_text_primary"
        android:textColorHint="@color/widget_text_secondary"
        android:textSize="16sp"
        android:popupBackground="@color/widget_surface_light"
        android:dropDownVerticalOffset="4dp" />

    <!-- Account -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Account"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <Spinner
        android:id="@+id/spinner_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background"
        android:layout_marginBottom="12dp"
        android:popupBackground="@color/widget_surface_light" />

    <!-- Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Description (optional)"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/edit_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edit_text_background"
        android:hint="What was it for?"
        android:inputType="text"
        android:layout_marginBottom="20dp"
        android:textColor="@color/widget_text_primary"
        android:textColorHint="@color/widget_text_secondary"
        android:textSize="16sp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:text="Cancel"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/button_save_background"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Save"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
